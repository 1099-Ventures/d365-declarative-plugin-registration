<Project Sdk="Microsoft.NET.Sdk">

	<!-- Samples: registration attributes in late-bound and early-bound plugin projects.
	     LangVersion 7.3 proves the attribute source compiles for .NET Framework plugin projects. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>7.3</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- Consumers get this file from the source package. The samples link it directly. -->
		<Compile Include="../../src/Ten99.D365.PluginRegistration/Attributes.cs" Link="Ten99.D365.PluginRegistration/Attributes.cs" />
	</ItemGroup>

</Project>
