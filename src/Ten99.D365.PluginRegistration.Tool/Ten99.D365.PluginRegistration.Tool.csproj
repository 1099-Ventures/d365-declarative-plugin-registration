<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Ten99.D365.PluginRegistration.Tool</RootNamespace>

		<IsPackable>true</IsPackable>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>d365-plugin-reg</ToolCommandName>
		<Description>Registers Dataverse plugin steps and images declared with Ten99.D365.PluginRegistration attributes. Plans and applies the registration from any OS, locally or in a pipeline.</Description>
		<PackageTags>dataverse;dynamics365;d365;plugin;registration;power-platform;cli</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.27" />
		<PackageReference Include="System.CommandLine" Version="2.0.12" />
		<PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.12" />
		<!-- Dataverse.Client brings 8.0.2 transitively, which has known vulnerabilities -->
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Ten99.D365.PluginRegistration.Tool.Tests" />
	</ItemGroup>

</Project>
