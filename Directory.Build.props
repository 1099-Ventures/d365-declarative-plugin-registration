<Project>

	<PropertyGroup>
		<Authors>1099 Ventures</Authors>
		<Company>1099 Ventures</Company>
		<Copyright>Copyright (c) 1099 Ventures</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/1099-Ventures/d365-declarative-plugin-registration</PackageProjectUrl>
		<RepositoryUrl>https://github.com/1099-Ventures/d365-declarative-plugin-registration</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<VersionPrefix>0.1.0</VersionPrefix>
		<VersionSuffix>alpha</VersionSuffix>

		<IsPackable>false</IsPackable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsPackable)' == 'true'">
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
	</ItemGroup>

</Project>
