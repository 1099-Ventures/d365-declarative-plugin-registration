<Project Sdk="Microsoft.NET.Sdk">

	<!-- Design sample: registration attributes in late-bound and early-bound plugin projects.
	     LangVersion 7.3 proves the attribute source compiles for .NET Framework plugin projects. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>7.3</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

</Project>
